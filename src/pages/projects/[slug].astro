---
import { getCollection, type CollectionEntry } from "astro:content";
import { getImage, Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { absolute, LINKEDIN, PERSON_ID, BASE } from "../../data/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const STORY_CHAPTERS = { origins: "Rover years", control: "Sensing & recovery" } as const;
const HERO_WIDTHS = [480, 800, 1200];

const { project } = Astro.props as { project: CollectionEntry<"projects"> };
const { data } = project;
const path = `/projects/${project.id}.html`;
const canonical = absolute(path);
const chapterTitle = STORY_CHAPTERS[data.storyChapter];
const storyRoute = `/about.html#${data.storyChapter}`;

// Never upscale: cap generated widths at the source width.
const heroWidth = Math.min(1200, data.image.width);
const heroWidths = [...new Set(HERO_WIDTHS.map((width) => Math.min(width, data.image.width)))];
const social = await getImage({ src: data.image, format: "jpeg", width: heroWidth });
const socialUrl = absolute(social.src);

const graph = [
  { "@type": "WebPage", "@id": `${canonical}#webpage`, url: canonical, name: data.title, description: data.summary, inLanguage: "en", mainEntity: { "@id": `${canonical}#project` } },
  { "@type": "CreativeWork", "@id": `${canonical}#project`, name: data.title, description: data.summary, url: canonical, image: socialUrl, author: { "@id": PERSON_ID } },
  { "@type": "Person", "@id": PERSON_ID, name: "Ragesh Ramachandran", url: BASE },
];
---
<BaseLayout
  title={data.seoTitle ?? `${data.title} | Ragesh Ramachandran`}
  description={data.summary}
  path={path}
  image={social.src}
  imageAlt={data.imageAlt}
  active="story"
  current="true"
  mainClass="project-page container"
  graph={graph}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/about.html">My story</a><span aria-hidden="true">/</span><a href={storyRoute}>{chapterTitle}</a></nav>
  <h1>{data.title}</h1>
  <p class="project-context">{data.context}</p>
  <p class="project-lead">{data.intro}</p>
  <Picture
    class="project-hero-image"
    src={data.image}
    alt={data.imageAlt}
    formats={["avif"]}
    fallbackFormat="webp"
    width={heroWidth}
    widths={heroWidths}
    sizes="(min-width: 724px) 660px, calc(100vw - 64px)"
    loading="eager"
    fetchpriority="high"
  />
  <div class="project-body">
    {data.sections.map((section) => (
      <section class="project-section"><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>
    ))}
    <div class="project-links">{data.links.map((link, index) => <Fragment>{index > 0 && " "}<a class="button" href={link.url}>{link.label}</a></Fragment>)}</div>
    {data.videos.length > 0 && (
      <section class="project-section">
        <h2>Watch the project in motion</h2>
        {data.videos.map((video, i) => (
          <Fragment>
            <iframe class="project-video" src={`https://www.youtube-nocookie.com/embed/${video}`} title={`${data.title} — demonstration ${i + 1}`} loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
            <a class="text-link" href={`https://www.youtube.com/watch?v=${video}`}>Watch demonstration {i + 1} on YouTube <span class="arrow diagonal" aria-hidden="true"></span></a>
          </Fragment>
        ))}
      </section>
    )}
  </div>
  <section class="section continue-reading">
    <h2>Continue the story.</h2>
    <p>See how this chapter connects to the engineering work that followed—or get in touch if it connects with something you’re building.</p>
    <div class="continue-actions">
      <a class="button primary-button" href={storyRoute}>Return to {chapterTitle.toLowerCase()} <span class="arrow" aria-hidden="true"></span></a>
      <a class="text-link" href={LINKEDIN}>Talk with me on LinkedIn <span class="arrow diagonal" aria-hidden="true"></span></a>
    </div>
  </section>
</BaseLayout>
