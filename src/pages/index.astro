---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageMeta } from "../data/pages";
import portrait from "../assets/ragesh-roscon-2023.webp";

const meta = pageMeta("home");
---
<BaseLayout {...meta} active="home" bodyClass={meta.bodyClass}>
  <section class="intro consulting-hero" aria-labelledby="intro-title">
    <div class="hero-content">
      <h1 id="intro-title">I build dependable systems for <span>robotics and physical AI.</span></h1>
      <p class="hero-copy">I’m Ragesh. I’ve spent the past decade working on robots, from university rovers to industrial fleets. Today, I build software infrastructure for defense robotics.</p>
    </div>
    <figure class="hero-speaker">
      <Image src={portrait} widths={[240, 480, 800]} sizes="(max-width: 800px) 104px, 360px" loading="eager" fetchpriority="high" alt="Ragesh Ramachandran speaking at ROSCon India 2023" />
      <figcaption><strong>Ragesh Ramachandran</strong><span>Robotics engineer · Founder of Robotair</span> <a href="https://www.youtube.com/watch?v=p302LwKIhQg">Watch my ROSCon India 2023 talk <span class="arrow diagonal" aria-hidden="true"></span></a>
      </figcaption>
    </figure>
    <div class="hero-explore">
      <p class="hero-discovery">Start with my story, then follow the work and ideas it led to. If they resonate, stay in touch through Medium or LinkedIn.</p>
      <div class="hero-actions">
        <a class="button primary-button" href="/about.html">Start with my story <span class="arrow" aria-hidden="true"></span></a>
        <a class="text-link" href="/writing.html">Here for the writing? <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>
</BaseLayout>
