---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { pageMeta } from "../data/pages";
import portrait from "../assets/ragesh-roscon-2023.webp";

const meta = pageMeta("home");
---
<BaseLayout {...meta} active="home" bodyClass={meta.bodyClass}>
  <section class="intro consulting-hero" aria-labelledby="intro-title">
    <div class="hero-content">
      <h1 id="intro-title">Hi, I’m <span>Ragesh.</span></h1>
      <p class="hero-lead">I build dependable systems for robotics and physical AI.</p>
      <p class="hero-copy">I’ve spent the past decade working on robots, from university rovers to industrial fleets. Today, I build software infrastructure for defense robotics.</p>
      <p class="hero-perspective">My starting point: <a href="/how-i-work.html#principles">people first, process next, tools last</a>. I value simple systems, honest conversations, and sharing what I learn.</p>
    </div>
    <figure class="hero-speaker">
      <Image src={portrait} widths={[240, 480, 800]} sizes="(max-width: 800px) 104px, 360px" loading="eager" fetchpriority="high" alt="Ragesh Ramachandran speaking at ROSCon India 2023" />
      <figcaption><strong>At ROSCon India, 2023</strong><span>Sharing Robotair, the company I founded.</span> <a href="https://www.youtube.com/watch?v=p302LwKIhQg">Watch my talk <span class="arrow diagonal" aria-hidden="true"></span></a>
      </figcaption>
    </figure>
    <div class="hero-explore">
      <div class="hero-actions">
        <a class="button primary-button" href="/about.html">Start with my story <span class="arrow" aria-hidden="true"></span></a>
        <a class="text-link" href="/writing.html">Read my writing <span class="arrow" aria-hidden="true"></span></a>
      </div>
    </div>
  </section>
</BaseLayout>
