---
import { LINKEDIN } from "../data/site";

interface Props {
  heading: string;
  description: string;
  /** Secondary destination shown next to the LinkedIn call to action. */
  href: string;
  label: string;
}
const { heading, description, href, label } = Astro.props;
---
<section class="section continue-reading">
  <h2>{heading}</h2>
  <p>{description}</p>
  <div class="continue-actions"><a class="button primary-button" href={LINKEDIN}>Get in touch on LinkedIn <span class="arrow diagonal" aria-hidden="true"></span></a>
  <a class="text-link" href={href}>{label} <span class="arrow" aria-hidden="true"></span></a></div>
</section>
