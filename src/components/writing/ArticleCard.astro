---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface MediumPost {
  title: string;
  url: string;
  date: string;
  displayDate: string;
  excerpt: string;
  topics: string[];
  image: string;
  /** Cached thumbnail relative to src/assets/, e.g. "medium/<hash>.webp"; empty for text-only cards. */
  localImage: string;
}

interface Props {
  post: MediumPost;
}

const covers = import.meta.glob<{ default: ImageMetadata }>("../../assets/medium/*.webp", { eager: true });
const { post } = Astro.props;
// A missing thumbnail degrades to a text-only card rather than failing the build.
const cover = post.localImage ? covers[`../../assets/${post.localImage}`]?.default : undefined;
// Same spacing as the previous generator's json.dumps output; site.js parses it as JSON.
const topics = `[${post.topics.map((topic) => JSON.stringify(topic)).join(", ")}]`;
---
<article class="article-card" data-topics={topics}>
  {cover && <Image class="article-cover" src={cover} width={800} height={450} loading="lazy" alt="" />}
  <div class="article-meta"><time datetime={post.date}>{post.displayDate}</time><span>On Medium</span></div>
  <h3><a href={post.url}>{post.title}</a></h3>
  <p>{post.excerpt}</p>
  <a class="text-link" href={post.url} aria-label={`Read on Medium: ${post.title}`}>Read on Medium <span class="arrow diagonal" aria-hidden="true"></span></a>
</article>
